<%- include('partials/header') %>
<main>
  <h1>Service Projects</h1>
  <ul>
    <% projects.forEach(project => { %>
      <li>
        <strong><%= project.date.toDateString() %></strong>: 
        <%= project.title %> 
        (<%= project.organization_name %>)
      </li>
    <% }); %>
  </ul>
</main>
<%- include('partials/footer') %>
