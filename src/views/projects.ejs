<!-- src/views/projects.ejs -->

<%- include('partials/header') %>
<main>
  <h1>Upcoming Service Projects</h1>

  <p><a href="/new-project">Add a New Service Project</a></p>

  <ul>
    <% projects.forEach(project => { %>
      <li>
        <!-- Link to project details page -->
        <a href="/project/<%= project.project_id %>">
          <%= project.title %>
        </a>
        -
        <!-- Link to organization details page -->
        <a href="/organization/<%= project.organization_id %>">
          <%= project.organization_name %>
        </a>
        (<strong><%= project.date.toDateString() %></strong>, <%= project.location %>)
      </li>
    <% }); %>
  </ul>
</main>
<%- include('partials/footer') %>
